# Copy to .env and fill in real values. Never commit .env.

# ─── Runtime ───────────────────────────────────────────────
NODE_ENV=development            # development | production | test
PORT=4000
# Comma-separated list of allowed browser origins (CORS)
FRONTEND_URL=http://localhost:3000
# Express "trust proxy". Default "loopback" suits nginx on the same host.
# Use a hop count (e.g. 1) behind a load balancer, or "false" if exposed directly.
TRUST_PROXY=loopback
# Swagger UI at /api/docs. Defaults to true in development, false in production.
SWAGGER_ENABLED=
# Log every request (errors, 4xx and slow requests are always logged)
LOG_ALL_REQUESTS=false

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://yarn_erp:yarn_erp_password@localhost:5432/yarn_erp
# Prisma pool size per process and wait time (seconds) for a free connection
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT=30

# ─── Auth ──────────────────────────────────────────────────
# At least 32 random characters each, and different from each other.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
# Set when frontend and API share a parent domain, e.g. .example.com
COOKIE_DOMAIN=

# ─── Data encryption ───────────────────────────────────────
# Encrypts bank account numbers in the database (AES-256-GCM). 64 hex characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a safe copy: if it is lost, stored account numbers cannot be read again. Never change it once set.
DATA_ENCRYPTION_KEY=

# ─── First admin (npm run create:superadmin) ───────────────
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ─── File storage ──────────────────────────────────────────
# Cloudflare R2 is used when account/key/secret/bucket are all set;
# otherwise uploads are written to LOCAL_UPLOAD_DIR.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: used only when R2_ACCOUNT_ID is empty
R2_ENDPOINT=
R2_PUBLIC_URL=
LOCAL_UPLOAD_DIR=./uploads

# ─── Demo seed (DESTRUCTIVE — wipes every table) ───────────
# ALLOW_DESTRUCTIVE_SEED=true
# DEMO_PASSWORD=Demo@12345
